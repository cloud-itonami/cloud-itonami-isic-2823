 :itonami.blueprint/license "AGPL-3.0-or-later"
 :itonami.blueprint/social-impact [:worker-safety :equipment-safety :structural-integrity-transparency :quality-defect-transparency]
 :itonami.blueprint/governor :metallurgy-machinery-plant-operations-governor
 :itonami.blueprint/robotics true
 :itonami.blueprint/required-technologies [:robotics :identity :forms :dmn :bpmn :audit-ledger :eda :cae]
